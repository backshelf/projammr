# Copy to .env at the repo root; docker compose reads it from there.
# (apps/server/.env stays as-is for running the server outside Docker.)

# The database's role, password and name. The db service creates them the
# first time it starts on an empty volume; changing them afterwards does not
# rename or re-password the database that already exists.
POSTGRES_USER=projammr
POSTGRES_PASSWORD=projammr
POSTGRES_DB=projammr

# Which release of the api and web images the stack pulls. Unset, it follows
# `latest`; pin a release (for example 1.2.0) to upgrade on purpose, by
# changing it and running `docker compose pull && docker compose up -d`.
# PROJAMMR_VERSION=latest

# Better Auth signing secret. Generate one with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=

# Root key for note encryption. Generate one with `openssl rand -base64 32`.
# Losing this makes every note unreadable — there is no re-key path without it.
NOTES_MASTER_KEY=

# Which generation of NOTES_MASTER_KEY the notes are wrapped under. Raise it by
# one each time you rotate the key and leave it at that value afterwards; unlike
# NOTES_MASTER_KEY_PREVIOUS it is not temporary. The API refuses to start when
# NOTES_MASTER_KEY cannot open the notes stored under this version.
# NOTES_KEY_VERSION=1

# The one hostname the app is opened by, lowercase, without scheme or port: a
# machine's mDNS name (my-machine.local), a LAN IP, or a domain. The stack is
# served at https://<PUBLIC_HOST> by the proxy service, which signs the
# certificate with its own local CA; every device that opens the site trusts
# that CA's root once, from http://<PUBLIC_HOST>/ca.crt. Every URL the services
# need (Better Auth, CORS) is derived from this value when they start, and the
# web app reads its own origin from each request, so a change takes effect
# when the services are recreated (`docker compose up -d`). Served from Tailscale
# instead (TS_AUTHKEY below), it is the node's MagicDNS name,
# <name>.<tailnet>.ts.net.
PUBLIC_HOST=localhost

# Serves the stack from a Tailscale node in place of the Caddy proxy: add
# `COMPOSE_FILE=docker-compose.yml:docker-compose.tailscale.yml` to .env and
# set PUBLIC_HOST to <name>.<tailnet>.ts.net. The stack joins your tailnet as
# a node called <name>, serves itself under a certificate Tailscale issues,
# which every device already trusts, and through Funnel answers the internet
# as well as the tailnet. The tailnet needs MagicDNS and HTTPS certificates
# turned on, and Funnel allowed for the node. Building the images from source
# puts docker-compose.build.yml in that list too, for example
# `COMPOSE_FILE=docker-compose.yml:docker-compose.build.yml:docker-compose.tailscale.yml`.
#
# The auth key the node logs in with the first time it starts, from the
# Tailscale admin console's Keys page. The login is kept in the
# `tailscale-state` volume, so a single-use key is enough and may expire
# afterwards.
# TS_AUTHKEY=

# Only for a page on another origin that calls the API from a browser (a
# dashboard on a different host). The app itself needs nothing here: its own
# origin, https://<PUBLIC_HOST>, is trusted by default. Setting this replaces
# that default, so keep https://<PUBLIC_HOST> in the list, or the app's own
# cookie-authenticated form posts fail with a 403 (the API logs "refused
# origin"). The proxy answers only PUBLIC_HOST, so another name for this
# machine is not an origin to list; to open the stack by a different name,
# change PUBLIC_HOST and recreate the services.
# TRUSTED_ORIGINS=https://localhost,https://dashboard.example.com

# API address for server-side calls (SSR, server actions, the forward of the
# browser's /api requests) when the client runs outside compose. The compose
# file gives its web service the API's service address (http://api:8080) and
# does not read this value.
# INTERNAL_API_URL=http://localhost:8080

# How many trusted reverse proxies sit in front of the API and append to
# X-Forwarded-For — 1 here: Caddy, the only way in, proxies /api and /media
# straight to the API. The Tailscale node does the same and sets the header
# to the caller's address outright, so it is 1 there too. Outside Docker the
# server itself defaults to 0, which
# ignores the header entirely rather than trusting any part of it. Wrong in
# either direction is a real gap: too high lets a caller pick its own address,
# too low keys every caller on one shared bucket.
# TRUSTED_PROXY_HOPS=1

# Whether the site is served under a publicly trusted certificate, which is
# the only case in which the API sends HSTS. The proxy has one HTTPS site,
# signed by Caddy's own local CA, so `internal` is the only mode it serves:
# leave this unset. `acme` would switch HSTS on in the API while the proxy
# still serves the local CA's certificate, and a browser that remembers HSTS
# for a self-signed CA can be locked out the next time that CA changes. The
# Tailscale override sets `acme` itself, since its certificate is publicly
# trusted.
# TLS_MODE=internal

# The largest file the API accepts in one upload, in megabytes (MiB). The API
# holds the whole of an upload in memory while it handles it, so a higher
# limit costs up to that much server RAM for every upload in flight at once;
# a client may send several at a time. Files over the limit are refused. At most
# 2048. This seeds Settings → Instance → Limits, "Largest upload": the setting
# holds this value until an admin changes it there, which applies at once, and
# comes back to it on a reset. A change here applies when the API restarts.
MAX_UPLOAD_MB=128

# SMTP connection string for outgoing mail (password reset, email
# verification, invite delivery, change-email and delete-account
# confirmation) — e.g. smtps://user:pass@smtp.example.com:465. Unset means
# this instance sends no mail: those flows hide themselves, and password
# recovery falls to the instance admin (`POST /admin/users/:id/reset-link` or
# `docker compose exec api bun dist/scripts/reset-link.js <email>`).
# SMTP_URL=
# The address every outgoing mail's From header carries. Required once
# SMTP_URL is set; a display name here is discarded — the instance's
# "instance-branding.mailSenderName" setting supplies that instead. Both a
# bare address and a "Name <address>" value are accepted.
# MAIL_FROM=noreply@example.com

# The most storage, in gigabytes, one project may hold, and one account may
# hold across every project. Unset means no cap. An upload that would take a
# project or an account past its cap is refused. These seed Settings →
# Instance → Limits, "Storage per project" and "Storage per account": an admin
# can change a cap set here, but only unsetting the variable removes it.
# MAX_PROJECT_GB=
# MAX_USER_GB=

# How many audio files the background analysis queue (peaks, loudness,
# spectrum and the rest) decodes at once. Each one spawns an ffmpeg child
# process, so raising this multiplies CPU load — leave it at the default
# unless the host has room to spare. This seeds Settings → Instance →
# Background work, "Jobs at once", which an admin can change there at once.
# MEDIA_CONCURRENCY=2

# How many days the content of a save that was never committed is kept. After
# this the save stays in the history but its content is removed, and sample
# files nothing references any more are freed. Whole days, 1 to 36500; the
# default is 90. This seeds Settings → Instance → Background work, "Keep the
# content of uncommitted saves for", which an admin can change there.
# SAVE_CONTENT_RETENTION_DAYS=90

# Delay before a failed job is retried, multiplied by the attempt number
# (5 s, then 10 s). Only kinds registered with a maxAttempts above 1 retry.
# JOB_RETRY_DELAY_MS=5000
