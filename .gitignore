# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

samples

# dependencies
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js
.next/
out/

# production
build
dist

# turbo
.turbo

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/apps/server/deps/

# Local agent config and worktrees (stays local on backshelf repos)
.claude/

# Python bytecode
__pycache__/

# impeccable's review captures and local config (the critiques, design.json and surface briefs are committed)
**/.impeccable/review/
**/.impeccable/config.local.json

# enola's architecture snapshot and extractor cache
.enola/

# JetBrains IDE settings
.idea/
apps/server/.idea/
