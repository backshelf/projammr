{
  "name": "client",
  "version": "0.9.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "private": true,
  "scripts": {
    "build:worklet": "bun build src/lib/dsp/processor.worklet.ts --outfile public/dsp-processor.js --target browser --format esm --minify",
    "dev": "bun run build:worklet && bun --bun next dev",
    "build": "bun run build:worklet && bun --bun next build",
    "start": "bun --bun next start",
    "lint": "bun --bun eslint",
    "format": "bun --bun prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "bun check",
    "test": "bun test --parallel --timeout=30000"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^7.0.8",
    "@tabler/icons-react": "^3.51.0",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.26",
    "@workspace/api": "workspace:*",
    "@workspace/dsp": "workspace:*",
    "@workspace/security-headers": "workspace:*",
    "@workspace/session-diff": "workspace:*",
    "@workspace/settings": "workspace:*",
    "@workspace/ui": "workspace:*",
    "better-auth": "^1.7.19",
    "class-variance-authority": "^0.7.1",
    "graphology": "^0.26.0",
    "graphology-layout": "^0.6.1",
    "graphology-layout-forceatlas2": "^0.10.1",
    "graphology-layout-noverlap": "^0.4.2",
    "libflacjs": "5.6.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/audioworklet": "^0.0.101",
    "@types/bun": "^1.4.4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/test": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^10.14.0",
    "graphology-types": "^0.24.8",
    "typescript": "^7.1.0-dev.20261010.1"
  }
