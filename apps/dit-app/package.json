{
  "name": "dit-app",
  "version": "0.9.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "description": "dit's menu bar app: the bar item, the panel and the daemon behind them",
  "homepage": "https://github.com/backshelf/projammr",
  "type": "module",
  "scripts": {
    "dev": "tauri dev -c src-tauri/tauri.dev.conf.json",
    "dev:web": "vite",
    "build": "vite build && bun run typecheck",
    "typecheck": "bun check",
    "lint": "bun --bun eslint --cache .",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "test": "bun test --parallel --timeout=30000",
    "format": "bun --bun prettier --write . && cd src-tauri && cargo fmt",
    "package": "tauri build --bundles app,dmg"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.52.0",
    "@tauri-apps/api": "~2.12.5",
    "@tauri-apps/plugin-dialog": "~2.8.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4",
    "@tauri-apps/cli": "~2.12.6",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.3.0",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/session-diff": "workspace:*",
    "@workspace/test": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "@workspace/ui": "workspace:*",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "^7.1.0-dev.20261010.1",
    "vite": "^8.3.7"
  }
}
