{
  "name": "server",
  "version": "1.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "format": "bun --bun prettier --write \"**/*.ts\"",
    "build": "bun build src/server.ts src/db/migrate.ts src/lib/audio-analysis-worker.ts --target=bun --packages=external --outdir=dist && bun build scripts/reset-link.ts scripts/make-admin.ts scripts/rotate-notes-key.ts scripts/migrate-storage.ts scripts/ingest-external-images.ts --target=bun --packages=external --outdir=dist/scripts",
    "start": "bun dist/server.js",
    "lint": "bun --bun eslint .",
    "typecheck": "bun check -p tsconfig.typecheck.json",
    "typegen": "MCP_DISABLED=1 bun scripts/generate-api.ts",
    "postinstall": "bun scripts/ensure-wordnet-index.mjs",
    "generate": "bun --bun drizzle-kit generate",
    "migrate": "bun src/db/migrate.ts",
    "test:smoke": "bun test --parallel --timeout=30000 ./src/auth.test.ts ./src/routes/me.test.ts ./src/entities/project/routes.test.ts ./src/entities/collection/routes.test.ts ./src/entities/track/routes.test.ts ./src/entities/track-audio/routes.test.ts ./src/routes/comments.test.ts ./src/entities/session/routes.test.ts",
    "test": "bun run test:parallel && bun run test:serial",
    "test:parallel": "bun test --parallel --timeout=30000 --path-ignore-patterns='dist/**' --path-ignore-patterns='src/db/migrator.test.ts' --path-ignore-patterns='src/db/queries/jobs.test.ts' --path-ignore-patterns='src/db/queries/jobs-outstanding.test.ts' --path-ignore-patterns='src/db/queries/storage-audit.test.ts' --path-ignore-patterns='src/db/queries/storage-limits.test.ts' --path-ignore-patterns='src/db/queries/save-retention.test.ts' --path-ignore-patterns='src/db/queries/settings.test.ts' --path-ignore-patterns='src/db/queries/project-policy-settings.test.ts' --path-ignore-patterns='src/db/queries/instance-users.test.ts' --path-ignore-patterns='src/db/queries/account-deletion.test.ts' --path-ignore-patterns='src/routes/instance.test.ts' --path-ignore-patterns='src/routes/settings.test.ts' --path-ignore-patterns='src/routes/settings-instance.test.ts' --path-ignore-patterns='src/routes/settings-instance-mcp-off.test.ts' --path-ignore-patterns='src/static.test.ts' --path-ignore-patterns='src/entities/project/delete-order.test.ts'",
    "test:serial": "bun test --isolate --timeout=30000 ./src/db/migrator.test.ts ./src/db/queries/jobs.test.ts ./src/db/queries/jobs-outstanding.test.ts ./src/db/queries/storage-audit.test.ts ./src/db/queries/storage-limits.test.ts ./src/db/queries/save-retention.test.ts ./src/db/queries/settings.test.ts ./src/db/queries/project-policy-settings.test.ts ./src/db/queries/instance-users.test.ts ./src/db/queries/account-deletion.test.ts ./src/routes/instance.test.ts ./src/routes/settings.test.ts ./src/routes/settings-instance.test.ts ./src/routes/settings-instance-mcp-off.test.ts ./src/static.test.ts ./src/entities/project/delete-order.test.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.5",
    "@better-auth/mcp": "^1.7.19",
    "@mjackson/multipart-parser": "^0.10.1",
    "@modelcontextprotocol/server": "^2.4.0",
    "@scalar/hono-api-reference": "^0.12.18",
    "@workspace/dit": "workspace:*",
    "@workspace/dsp": "workspace:*",
    "@workspace/media": "workspace:*",
    "@workspace/security-headers": "workspace:*",
    "@workspace/session-diff": "workspace:*",
    "@workspace/settings": "workspace:*",
    "better-auth": "^1.7.19",
    "cmu-pronouncing-dictionary": "^3.0.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "^4.13.17",
    "hono-openapi": "^1.5.0",
    "nodemailer": "^10.4.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "syllable": "^5.0.1",
    "wordnet-db": "^3.1.14",
    "wordpos": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.20.0",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/test": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "^7.1.0-dev.20261010.1"
  }
}
