    "screenshots": "bun scripts/screenshots/capture.ts"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.10",
    "@astrojs/react": "^7.1.9",
    "@astrojs/sitemap": "^3.7.6",
    "@astrojs/starlight": "^0.43.1",
    "@tabler/icons-react": "^3.53.0",
    "@tailwindcss/vite": "^4.3.5",
    "@workspace/session-diff": "workspace:*",
    "@workspace/ui": "workspace:*",
    "astro": "^7.4.13",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "satteri": "^0.11.7",
    "sharp": "^0.35.5",
    "starlight-links-validator": "^0.27.0",
    "starlight-openapi": "^0.27.0",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@astrojs/ts-content-mapper": "^0.2.0",
    "@types/bun": "^1.4.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@workspace/demo": "workspace:*",
    "@workspace/eslint-config": "workspace:*",
    "eslint": "^10.15.0",
    "server": "workspace:*",
    "typescript": "7.1.0-dev.20261010.1"
  }
