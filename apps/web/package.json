  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "bun --bun eslint",
    "format": "bun --bun prettier --write \"**/*.{ts,tsx,astro}\"",
    "typecheck": "astro sync && bun scripts/typecheck.ts",
