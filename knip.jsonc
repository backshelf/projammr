// knip: unused files, exports, types, duplicate exports and dependencies across every
// workspace. `bun run knip`; CI runs it in the typecheck-build job, after the steps that
// generate the gitignored v1.d.ts and routeTree.gen.ts it resolves. Knip's own plugins find most
// entries (Next, Astro, Playwright, the test files). This file names the rest, and
// every false positive is listed with the reason it is one.
{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "apps/server": {
      // The one-off backfills and the operator scripts the api image ships,
      // all run by path. knip finds server.ts and the migrator through package scripts.
      "entry": ["src/db/backfill-*.ts", "scripts/*.{ts,mjs}"],
    },
    "apps/dit-app": {
      // The theme script index.html loads before React. knip finds the Vite config,
      // index.html's module script and the tests itself.
      "entry": ["public/*.js"],
      // src/ipc.ts is the contract with the Rust side: its types are the vocabulary the
      // panel's screens import as they land, and some only the Rust twin names.
      "ignoreIssues": { "src/ipc.ts": ["types"] },
      "ignoreDependencies": [
        // Loaded by name from postcss.config.mjs, which re-exports @workspace/ui's config.
        "@tailwindcss/postcss",
      ],
    },
    "apps/client": {
      // The service worker the browser registers by URL, and the Turbopack loader
      // next.config.ts names by path.
      "entry": ["public/sw.js", "turbopack/*.cjs"],
      "ignoreDependencies": [
        // Loaded by name from postcss.config.mjs, which re-exports @workspace/ui's config.
        "@tailwindcss/postcss",
      ],
    },
    "apps/web": {
      "entry": ["scripts/**/*.ts"],
      "ignoreDependencies": [
        // Kept external to the prerender build so its native binding resolves under
        // Bun's isolated install (astro.config.ts); nothing imports it by name.
        "satteri",
      ],
    },
    "apps/e2e": {
      // The stack driver and the smoke run by path, from CI and by hand.
      "entry": ["src/*.ts"],
    },
  },
  // System binaries the code spawns; none is an npm package.
  "ignoreBinaries": [
    "agent-browser",
    "ffmpeg",
    "ffprobe",
    "pg_dump",
    "wasm-opt",
  ],
}
