{
  "name": "@workspace/demo",
  "version": "0.9.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "format": "bun --bun prettier --write \"**/*.ts\"",
    "typecheck": "bun check",
    "lint": "bun --bun eslint .",
    "test": "bun test --timeout=30000",
    "curate": "bun src/curate.ts",
    "demo-env": "bun src/demo-env.ts",
    "seed": "bun src/seed.ts",
    "snapshot": "bun src/snapshot.ts",
    "restore": "bun src/restore.ts"
  },
  "dependencies": {
    "@workspace/api": "workspace:*",
    "@workspace/dit": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^10.14.0",
    "typescript": "^7.1.0-dev.20261010.1"
  }
}
